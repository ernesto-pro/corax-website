{
  "name": "corax-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Corax — Social Media Company. Sito istituzionale, portfolio e properties.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:instagram": "node --env-file-if-exists=.env scripts/sync-instagram.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.7"
  }
}
